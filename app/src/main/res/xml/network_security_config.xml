<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IPTV streams from providers and LAN companion servers frequently operate over HTTP cleartext -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
